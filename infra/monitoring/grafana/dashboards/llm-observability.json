{
  "uid": "llm-observability",
  "title": "LLM Observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Inference Latency",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_inference_latency_ms_bucket[5m])) by (le, provider, model))",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion Throughput",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(llm_worker_jobs_processed_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker Errors",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(llm_worker_errors_total[5m]))",
          "legendFormat": "errors"
        }
      ]
    }
  ]
}